{
  "name": "play-with-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src src/index.ts --dev",
    "dev:lan": "node --watch --watch-path=src src/index.ts --dev --lan",
    "start": "node dist/index.js",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && vue-tsc -p tsconfig.web.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
